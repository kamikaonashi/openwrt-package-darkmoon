#!/bin/sh /etc/rc.common
# darkmoon - adaptive CAKE bandwidth controller

USE_PROCD=1
START=95
STOP=10

PROG=/usr/sbin/darkmoon

start_instance() {
	local cfg="$1" enabled

	config_get_bool enabled "$cfg" enabled 0
	[ "$enabled" -eq 1 ] || return 0

	procd_open_instance "$cfg"
	procd_set_param command "$PROG" "$cfg"
	# restart this instance whenever its configuration changes
	procd_set_param file /etc/config/darkmoon
	procd_set_param respawn "${respawn_threshold:-3600}" "${respawn_timeout:-5}" "${respawn_retry:-5}"
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param term_timeout 10
	procd_close_instance
}

start_service() {
	config_load darkmoon
	config_foreach start_instance darkmoon
}

service_triggers() {
	procd_add_reload_trigger darkmoon
}

status_service() {
	local obj found=0
	for obj in $(ubus list 'darkmoon.*' 2>/dev/null); do
		found=1
		echo "== ${obj#darkmoon.}"
		ubus call "$obj" status
	done
	[ "$found" -eq 1 ] || { echo "not running"; return 1; }
}
