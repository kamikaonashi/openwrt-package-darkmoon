CC      ?= gcc
CFLAGS  ?= -O2 -pipe
CFLAGS  += -std=gnu11 -Wall -Wextra -Wno-unused-parameter
LDLIBS  += -lubus -lubox -luci

SRCS = main.c config.c icmp.c rate_monitor.c tc_netlink.c ubus.c
OBJS = $(SRCS:.c=.o)
BIN  = darkmoon

.PHONY: all clean

all: $(BIN)

$(BIN): $(OBJS)
	$(CC) $(LDFLAGS) -o $@ $^ $(LDLIBS)

%.o: %.c
	$(CC) $(CFLAGS) -c -o $@ $<

clean:
	rm -f $(OBJS) $(BIN)

main.o:         main.c autorate.h config.h icmp.h rate_monitor.h tc_netlink.h
config.o:       config.c config.h
icmp.o:         icmp.c icmp.h
rate_monitor.o: rate_monitor.c rate_monitor.h
tc_netlink.o:   tc_netlink.c tc_netlink.h
ubus.o:         ubus.c autorate.h config.h
